        }
      }
    },
    "Demo Mode" : {
      "comment" : "Home Screen quick action, declared as UIApplicationShortcutItemTitle in Config/RefineID-iOS-Info.plist. The English title in the plist is the key.",
      "extractionState" : "manual",
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esittelytila"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demoläge"
          }
        }
      }
    },
    "NFCReaderUsageDescription" : {
      "comment" : "Purpose of reading the identity card by holding it to the iPhone. The English source is the NFCReaderUsageDescription value in Config/RefineID-iOS-Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID lukee henkilökorttiasi tunnistautumista, asiakirjojen allekirjoittamista, kortin käyttöönottoa ja PIN-koodien hallintaa varten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID läser ditt id-kort för inloggning, dokumentsignering, aktivering av kortet och hantering av PIN-koder."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth permission prompt, shown when the holder turns Remote Access on. The English source is the NSBluetoothAlwaysUsageDescription value in the app Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID yhdistää puhelimen ja tietokoneen Bluetoothilla, kun kortin etäkäyttö on päällä."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID ansluter telefonen och datorn via Bluetooth när fjärråtkomst till kortet är på."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt, shown when the holder chooses to scan the card access number. The English source is the NSCameraUsageDescription value in Config/RefineID-iOS-Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID lukee korttiin painetun pääsykoodin, jotta sinun ei tarvitse kirjoittaa sitä."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID läser åtkomstkoden som är tryckt på ditt kort så att du inte behöver skriva in den."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright 2026 Petri Koistinen"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright 2026 Petri Koistinen"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright 2026 Petri Koistinen"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local-network permission prompt, shown when the holder turns Remote Access on. The English source is the NSLocalNetworkUsageDescription value in the app Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID yhdistää puhelimen ja tietokoneen lähiverkossa, kun kortin etäkäyttö on päällä."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RefineID ansluter telefonen och datorn via det lokala nätverket när fjärråtkomst till kortet är på."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
