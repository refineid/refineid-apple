    "Activate Card": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivoi kortti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera kortet"
          }
        }
      }
    },
    "Activate the card first, then return here to take it into use.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivoi kortti ensin ja palaa sitten ottamaan se käyttöön."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera kortet först och kom sedan tillbaka för att ta det i bruk."
          }
        }
      }
    },
    "Activate this card first, then try setup again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate this card first, then try setup again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivoi kortti ensin, yritä sitten uudelleen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera kortet först, försök sedan igen."
          }
        }
      }
    },
    "Activating a card is not part of this version of RefineID.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin aktivointi ei kuulu tähän RefineID:n versioon."
