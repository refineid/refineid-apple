{
  "sourceLanguage": "en",
  "strings": {
    "Your phone needs an ID card, please.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone needs an ID card, please."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelin kaipaa henkilökorttia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilen behöver ID-kort."
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ signed": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ allekirjoitettu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ signerat"
          }
        }
      }
    },
    "%@, variant not in DVV's table": {
      "extractionState": "manual",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, muunnos ei ole DVV:n taulukossa"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, varianten finns inte i DVV:s tabell"
          }
        }
      }
    },
    "%@: %lld of %lld attempts left.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld of %3$lld attempts left."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld/%3$lld yritystä jäljellä."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld av %3$lld försök kvar."
          }
        }
      }
    },
    "%lld documents": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dokumenttia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dokument"
          }
        }
      }
    },
    "%lld documents to sign": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dokumenttia allekirjoitettavana"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dokument att underteckna"
          }
        }
      }
    },
    "%lld/%lld": {
      "extractionState": "manual",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld"
          }
        }
      }
    },
    "%u attempts remaining": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%u yritystä jäljellä"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%u försök kvar"
          }
        }
      }
    },
    "%u attempts remaining - low": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%u yritystä jäljellä - vähän"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%u försök kvar - få"
          }
        }
      }
    },
    "A correct entry restores the full count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A correct entry restores the full count."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikea koodi palauttaa kaikki yritykset."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rätt kod återställer alla försök."
          }
        }
      }
    },
    "A credential has fewer than five attempts remaining": {
      "extractionState": "manual",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdellä tunnusluvulla on alle viisi yritystä jäljellä"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kod har färre än fem försök kvar"
          }
        }
      }
    },
    "A credential is blocked or has at most two attempts remaining": {
      "extractionState": "manual",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnusluku on lukittu tai sillä on enintään kaksi yritystä jäljellä"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kod är spärrad eller har högst två försök kvar"
          }
        }
      }
    },
    "A wrong %@ spends one attempt. %lld attempts remain. Exhausting the %@ cannot be undone by software.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väärä %1$@ kuluttaa yhden yrityksen. Yrityksiä on jäljellä %2$lld. Loppuun kulunutta koodia %3$@ ei voi palauttaa ohjelmistolla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En felaktig %1$@ förbrukar ett försök. %2$lld försök återstår. En förbrukad %3$@ kan inte återställas med programvara."
          }
        }
      }
    },
    "A wrong current %@ spends one attempt. %lld attempts remain.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väärä nykyinen %1$@ kuluttaa yhden yrityksen. Yrityksiä on jäljellä %2$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En felaktig nuvarande %1$@ förbrukar ett försök. %2$lld försök återstår."
          }
        }
      }
    },
    "About RefineID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About RefineID"
