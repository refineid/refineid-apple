<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fi</string>
		<string>sv</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Outbound network contract. ATS stays open because an archival
	     signature needs two things: the timestamp authority (now named below) and revocation endpoints (still unpredictable):
	     the timestamp authority (the shipped qualified Sectigo
	     service, http://timestamp.sectigo.com/qualified) and the
	     revocation endpoints published inside the validated certificates
	     themselves (OCSP/CRL). Every such fetch goes through SigningNetwork,
	     which admits public IPs only. See Documentation/decisions.md,
	     2026-09-30 and 2026-11-16. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>timestamp.sectigo.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>ASiC-E Container</string>
			<key>UTTypeIdentifier</key>
			<string>org.etsi.asic-e</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>asice</string>
					<string>sce</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.etsi.asic-e+zip</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>RefineIDBuildSource</key>
	<string>$(REFINEID_BUILD_SOURCE)</string>
</dict>
</plist>
