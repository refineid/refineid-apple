<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The Safari Web Extension is sandboxed and only relays public Web eID
     protocol messages to the containing RefineID app over the shared App Group.
     It holds no smart-card, keychain, or network entitlements of its own. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fi.refineid.RefineID</string>
	</array>
</dict>
</plist>
