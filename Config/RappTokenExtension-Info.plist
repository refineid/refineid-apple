<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_refineid-rly._tcp</string>
		<string>_refineid-rly._udp</string>
		<string>_refineid-stream._tcp</string>
		<string>_refineid-stream._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RefineID connects to your paired card-holding device over the local network.</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>com.apple.ctk.class-id</key>
			<string>fi.refineid.ReFineID.rapp-token</string>
			<key>com.apple.ctk.driver-class</key>
			<string>$(PRODUCT_MODULE_NAME).PersistentTokenDriver</string>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.ctk-tokens</string>
	</dict>
</dict>
</plist>
