<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fi</string>
		<string>sv</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Outbound network contract. ATS stays open because an archival
	     signature needs two things: the timestamp authority (now named below) and revocation endpoints (still unpredictable):
	     the timestamp authority (http://timestamp.sectigo.com/qualified,
	     the only TSA) and the
	     revocation endpoints published inside the validated certificates
	     themselves (OCSP/CRL). Every such fetch goes through SigningNetwork,
	     which admits public IPs only. See Documentation/decisions.md,
	     2026-09-30. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>timestamp.sectigo.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_refineid-rly._tcp</string>
		<string>_refineid-rly._udp</string>
		<string>_refineid-stream._tcp</string>
		<string>_refineid-stream._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RefineID connects your phone and computer over the local network while Remote Access is on.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ASiC-E Container</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.etsi.asic-e</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>BDOC Container</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ee.ria.bdoc</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.etsi.asic-e</string>
			<key>UTTypeDescription</key>
			<string>ASiC-E Container</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>asice</string>
					<string>sce</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.etsi.asic-e+zip</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>ee.ria.bdoc</string>
			<key>UTTypeDescription</key>
			<string>BDOC Container</string>
			<key>UTTypeConformsTo</key>
			<array>
