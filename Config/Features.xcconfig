// Build-time feature flags: one place to turn a feature on or off.
//
// REFINEID_FEATURES feeds SWIFT_ACTIVE_COMPILATION_CONDITIONS through
// Version.xcconfig, which every configuration inherits. A flag absent
// here defines its feature away: everything the feature exclusively
// uses compiles out, so none of it ships; shared transports stay.
// Turning a feature back on is this flag plus the matching project
// packaging and archive inspection policy. Targets outside Xcode
// (SwiftPM packages) cannot see these flags and gate the same split
// by platform instead.
//
//   FEATURE_CONTACTLESS
//       Contactless card reading on macOS: the CAN entry.
//       The app and local token extension share the access number through
//       their app-group container. On iPhone, built-in NFC is required
//       and is not gated by this flag.
//
//   FEATURE_DOCUMENT_VERIFICATION
//       Signed document verification UI: the Verify action, sheet, and
//       verify-only drop state on macOS, and the Verify routes on iPhone
//       and iPad. Off on macOS in every configuration for the MVP; the
//       iPhone and iPad keep it, and the verifier and trusted-list store
//       beneath stay built and tested on both platforms.
//
//   FEATURE_PDF_STAMP
//       The visible PDF stamp: the CAN-gated mark carrying the
//       holder's name, SATU and card ink. Off, every signature stays
//       invisible - the non-rendering signature structures only - and
//       no stamp UI is offered. Off on macOS in every configuration
//       for the MVP; the iPhone and iPad keep it.
//
//   FEATURE_SCS
//       The loopback HTTPS signing service on macOS and its Settings
//       pane, started only after the holder opts in. Set by no
//       configuration until SCS ships; a local build that sets it also
//       needs a network-server entitlement.
//
//   FEATURE_TIMESTAMP_CONFIG
//       The Time Stamp Settings pane on macOS: the holder reads and
//       changes the RFC 3161 time-stamp authority signatures ask.
//       The store beneath stays built either way; with the pane
//       compiled out nothing writes the key, the store ignores a value
//       stored earlier, and every signature asks the shipped service.
//       Off on macOS in every configuration for the MVP; the iPhone
//       and iPad keep the Settings-app address.
//
// macOS ships contact-card authentication, management and document
// signing only: no remote card over RAPP, no contactless reader, no
// signed document verification, and no Settings panes. Every macOS
// signature is time-stamped by the qualified Sectigo server
// (http://timestamp.sectigo.com/qualified) and carries no visible stamp.
// The iPhone and iPad keep built-in NFC, remote access, verification,
// their configurable authority, and the stamp. To ship any of the gated
// features on macOS again, set its flag for macosx* below.

REFINEID_FEATURES = FEATURE_CONTACTLESS FEATURE_TIMESTAMP_CONFIG FEATURE_PDF_STAMP FEATURE_DOCUMENT_VERIFICATION

// macOS compiles out contactless reading, document verification, and
// every Settings pane.
REFINEID_FEATURES[sdk=macosx*] =

// The local card: this build talks to a card the device itself holds,
// over its own antenna. On by default, because every shipping iPhone
// and Mac has that hardware.
REFINEID_LOCAL_CARD_FEATURE = REFINEID_LOCAL_CARD

// REFINEID_REMOTE_CARD
//     The remote card: pairing this device with another over RAPP, and
//     everything a pairing makes possible. Empty on macOS in every
//     configuration; the iPhone and the iPad set it. The combined
//     conditions below outrank the config-only ones above wherever both
//     match, so no ordering between the stanzas can re-enable it. To
//     ship the remote card on macOS, delete the macosx* stanzas and
//     restore the embed, the declarations, and the archive policy.
REFINEID_REMOTE_CARD_FEATURE = REFINEID_REMOTE_CARD
REFINEID_REMOTE_CARD_FEATURE[config=TestFlight] = REFINEID_REMOTE_CARD
REFINEID_REMOTE_CARD_FEATURE[config=Release] = REFINEID_REMOTE_CARD
REFINEID_REMOTE_CARD_FEATURE[sdk=macosx*] =
REFINEID_REMOTE_CARD_FEATURE[sdk=macosx*,config=TestFlight] =
REFINEID_REMOTE_CARD_FEATURE[sdk=macosx*,config=Release] =

// FEATURE_CARD_ACTIVATION
//     Taking a factory-fresh card into use: the activation form.
REFINEID_ACTIVATION_FEATURE = FEATURE_CARD_ACTIVATION
REFINEID_ACTIVATION_FEATURE[config=TestFlight] = FEATURE_CARD_ACTIVATION
REFINEID_ACTIVATION_FEATURE[config=Release] = FEATURE_CARD_ACTIVATION

// FEATURE_ORGANIZATION_CARD
//     Organization cards end to end: setup, activation, card
//     management, authentication, signing and token publication.
//     Off in every build on every platform right now: set by no
//     configuration, in development, test and store builds alike,
//     until the owner turns it on. Turning it on is this flag (a
//     local build sets REFINEID_ORGANIZATION_CARD_FEATURE in
//     LocalFeatures.xcconfig); the code beneath stays built and
//     tested either way. Stored organization settings and primes
//     are left untouched either way; a build without the flag
//     refuses organization operations before any credential is
//     spent.
REFINEID_ORGANIZATION_CARD_FEATURE =

// A developer's own flags, out of the repository: the file is
// optional, ignored by git, and an assignment there replaces the
// default above on that machine only.
#include? "LocalFeatures.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(REFINEID_FEATURES) $(REFINEID_IOS_FLOOR_FEATURE) $(REFINEID_LOCAL_CARD_FEATURE) $(REFINEID_REMOTE_CARD_FEATURE) $(REFINEID_ACTIVATION_FEATURE) $(REFINEID_ORGANIZATION_CARD_FEATURE)
