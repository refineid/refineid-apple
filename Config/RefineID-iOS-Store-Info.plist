<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The Info.plist of the shipping iOS app, used by the TestFlight and
     Release configurations. It differs from RefineID-iOS-Info.plist, the
     development shape, in exactly what the first App Store release gates
     out (Documentation/decisions.md, 2026-08-21): no Bonjour service or
     local-network declaration, because the remote card does not ship; an
     NFC usage description that does not promise activation, because
     activation does not ship; and the nfc required capability, so the
     store never installs the app on a device without an antenna - which
     is every iPad, including iPads running iPhone apps in compatibility
     mode, and every Apple silicon Mac. Each delivery draws warning
     ITMS-90863 for the Mac half of that; the warning is informational
     and the exclusion is the point - the Mac gets its own app later.
     Do not remove nfc to silence it. Tests hold the two files to this
     exact difference. -->
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fi</string>
		<string>sv</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NFCReaderUsageDescription</key>
	<string>RefineID reads your identity card over NFC for authentication, document signing, and PIN management.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>RefineID reads the access number printed on your card so you do not have to type it.</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>eyeglasses</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Demo Mode</string>
			<key>UIApplicationShortcutItemType</key>
			<string>fi.refineid.shortcut.demonstration</string>
		</dict>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A000000063504B43532D3135</string>
		<string>A0000000181002030000000000000000</string>
		<string>A000000018434D00</string>
		<string>A000000151000000</string>
		<string>A0000002471001</string>
		<string>A000000308000010000100</string>
	</array>
</dict>
</plist>
