# Refuses any push with unformatted code, compilation failures, or failing unit tests.
# The gate is Scripts/test.sh pr. `git commit --no-verify` does not skip this.
#
# Activate once per clone:
#   git config core.hooksPath Scripts/githooks

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
updates=$(mktemp)
trap 'rm -f "$updates"' EXIT
cat > "$updates"
scope_status=0
python3 -B Scripts/DocumentationGate.py push "${1:-origin}" < "$updates" || scope_status=$?
case "$scope_status" in
  0) exit 0 ;;
  1) ;; # Code, mixed or unknown scope retains the full gate.
  *) exit "$scope_status" ;;
esac
Scripts/QualityReceipt.py verify-push < "$updates"
Scripts/test.sh pr
