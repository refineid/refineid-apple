# Refuses any commit containing whitespace errors or failing the lint gate.
# The gate is Scripts/test.sh commit.
#
# Activate once per clone:
#   git config core.hooksPath Scripts/githooks

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
scope_status=0
python3 -B Scripts/DocumentationGate.py commit || scope_status=$?
case "$scope_status" in
  0) exit 0 ;;
  1) ;; # Code, mixed or unknown scope retains the full gate.
  *) exit "$scope_status" ;;
esac
Scripts/test.sh commit
